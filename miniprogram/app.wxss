/* 全局样式 —— 沿用已定稿的卡片视觉语言（浅色卡 / 深色字 / 单一强调色）
   注意：这是可运行的骨架样式，正式视觉在 R2 访谈结论后再设计 */

page {
  background: #f8fafc;
  color: #111827;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.wrap { padding: 32rpx 32rpx 64rpx; }

/* 标题 */
.h1 { font-size: 46rpx; font-weight: 700; letter-spacing: 1rpx; }
.sub { font-size: 24rpx; color: #64748b; margin-top: 8rpx; }

/* 卡片 */
.card {
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 24rpx;
}

/* 徽标 */
.badge {
  display: inline-block;
  font-size: 22rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #2563eb;
}
.badge.gray { background: #f1f5f9; color: #475569; }
.badge.dark { background: #111827; color: #fff; }

/* 强调色文字 */
.accent { color: #2563eb; }
.muted { color: #64748b; }
.light { color: #64748b; }
.danger { color: #dc2626; }

/* 分隔线 */
.hr { height: 2rpx; background: #e2e8f0; margin: 24rpx 0; }

/* 主按钮 */
.btn {
  margin-top: 24rpx;
  background: #111827;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
}
.btn.ghost { background: #fff; color: #111827; border: 2rpx solid #cbd5e1; }
.btn.primary { background: #2563eb; }
.btn[disabled] { opacity: .45; }

/* 小按钮：标签本身可点（点一下删掉这一组）。
   视觉保持标签的紧凑感，点按区靠 ::after 隐形外扩到 ≈88rpx —— 不把标签做成大胶囊 */
.chip {
  position: relative;
  display: inline-block;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e2e8f0;
  font-size: 24rpx;
  color: #334155;
  margin: 8rpx 12rpx 0 0;
}
/* 隐形点按区：上下各外扩 11rpx（视觉 ≈66rpx，有效 ≈88rpx） */
.chip::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -11rpx;
  bottom: -11rpx;
}
.chip.on { border-color: #2563eb; color: #2563eb; background: #eff6ff; }

/* 免责声明 */
.disclaimer { margin-top: 40rpx; font-size: 22rpx; color: #64748b; line-height: 1.7; }
