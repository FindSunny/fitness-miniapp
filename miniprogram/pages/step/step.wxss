/* 顶部状态横幅：一眼看清"这一式现在是什么状态" */
.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.banner-title { font-size: 28rpx; font-weight: 700; }
.banner-sub { font-size: 22rpx; margin-top: 4rpx; opacity: .85; }
.banner.passed { background: #f0fdf4; border: 2rpx solid #86efac; color: #15803d; }
.banner.current { background: #eff6ff; border: 2rpx solid #bfdbfe; color: #1d4ed8; }
.banner.locked { background: #f8fafc; border: 2rpx solid #e2e8f0; color: #64748b; }

/* ---- 按标准一键记录 ---- */
.quick-label {
  font-size: 24rpx;
  color: #334155;
  margin-bottom: 10rpx;
}
.quick-row { display: flex; }
.quick-btn {
  min-height: 88rpx;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  background: #fff;
  border: 2rpx solid #cbd5e1;
  border-radius: 14rpx;
}
.quick-btn + .quick-btn { margin-left: 14rpx; }
.quick-btn.on { border-color: #2563eb; background: #eff6ff; }
.quick-btn .q-tier { font-size: 26rpx; font-weight: 700; color: #111827; }
.quick-btn .q-val { font-size: 20rpx; color: #64748b; margin-top: 4rpx; }
.quick-btn.on .q-tier { color: #1d4ed8; }

/* ---- 未解锁 ---- */
.locked-box {
  padding: 24rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
}
.locked-title { font-size: 28rpx; font-weight: 700; color: #475569; }
.locked-sub { font-size: 24rpx; color: #64748b; margin-top: 10rpx; line-height: 1.6; }
.locked-note { font-size: 22rpx; color: #64748b; margin-top: 10rpx; }

/* 极简模式提示（从首页"只有 10 分钟"进来时显示） */
.quick-tip {
  margin-bottom: 16rpx;
  padding: 18rpx 22rpx;
  background: #f8fafc;
  border: 2rpx dashed #cbd5e1;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}
.quick-tip-title {
  display: inline-block;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-weight: 700;
  font-size: 21rpx;
}

/* 顶部切换式 */
.nav-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.nav-btn {
  /* 视觉保持紧凑：'上一式/下一式'做大了很笨重（真机反馈）
     点按区不靠"把按钮做大"，靠 ::after 隐形外扩（见下）—— 视觉和点按区是两件事 */
  position: relative;
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  background: #fff;
  border: 2rpx solid #cbd5e1;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #111827;
}
/* 隐形点按区：上下各外扩 8rpx（视觉不变，有效高度 ≈ 41+16 = 89rpx） */
.nav-btn::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  top: -8rpx;
  bottom: -8rpx;
}
.nav-btn.off { opacity: .35; }
.nav-mid { width: 120rpx; text-align: center; font-size: 24rpx; color: #64748b; }

/* 历史记录的展开/收起（可点区域要够大） */
.hist-toggle {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 88rpx;
  color: #2563eb;
}

.pose-box {
  position: relative;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 20rpx;
}
.pose { width: 100%; }
.pose-empty {
  height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 12rpx;
}
.view-tag {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}
/* "点击看大图" 提示：放在右下角，不挡图 */
.zoom-tag {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  font-size: 22rpx;
  color: #1d4ed8;
  background: #eff6ff;
  border: 2rpx solid #bfdbfe;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

/* ---- 大图查看（自绘遮罩，不用 wx.previewImage：它不支持代码包内资源路径）---- */
.lightbox {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(8, 15, 30, .93);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.lightbox-img {
  width: 100%;
  height: 62vh;
  /* 必须有浅色底：我们的示意图是黑色线稿 + 透明底，
     直接放在深色遮罩上几乎看不见（只有浅色"墙"露出来）—— 这是看截图才发现的 */
  background: #fff;
  border-radius: 20rpx;
}
.lightbox-title {
  margin-top: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #f1f5f9;
  text-align: center;
}
.lightbox-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #cbd5e1;
}

.card-title {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.tier-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
  font-size: 28rpx;
}
.tier-row:last-child { border-bottom: none; }
.tier-row.hit .tier-name { color: #2563eb; font-weight: 700; }
.tier-name { width: 120rpx; color: #334155; }
.tier-val { flex: 1; color: #111827; }
.tier-flag { font-size: 22rpx; color: #2563eb; }

.input-row { display: flex; align-items: center; }
.num-input {
  flex: 1;
  height: 88rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}
.add-btn {
  flex: none;
  margin-left: 20rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 34rpx;
  background: #111827;
  color: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.sets { margin-top: 16rpx; }

.verdict {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 14rpx;
  font-size: 26rpx;
}

/* 历史记录 */
.hist-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
  font-size: 24rpx;
}
.hist-row:last-child { border-bottom: none; }
.hist-time { width: 190rpx; color: #64748b; font-size: 22rpx; }
.hist-sets { flex: 1; color: #334155; }
.hist-tier { color: #2563eb; font-size: 22rpx; }

/* 恢复未提交记录时的提示 */
.restored-tip {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: #eff6ff;
  border: 2rpx solid #bfdbfe;
  color: #1d4ed8;
  border-radius: 12rpx;
  font-size: 24rpx;
}

/* 上一次记录的结果（完成后的持久反馈） */
.last-result {
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f0fdf4;
  border: 2rpx solid #bbf7d0;
  border-radius: 14rpx;
}
.last-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #15803d;
  margin-bottom: 6rpx;
}

.nav-row { display: flex; margin-top: 24rpx; }
.half { flex: 1; }
.half + .half { margin-left: 20rpx; }

.final-tip {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  background: #fff7ed;
  border: 2rpx solid #fed7aa;
  color: #c2410c;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
}
