<view class="wrap">

  <view class="h1">六艺十式</view>
  <view class="sub">六个动作 · 每个十式 · 达到标准才进下一式</view>

  <!-- 价值主张：直接回应 R2 访谈里排第 2、3 的放弃原因（没时间 / 没器械）
       注意用词：是"不用**专业**器械"，不是"零器械" —— 引体要单杠、倒立撑要一面墙 -->
  <view class="value-line">不用专业器械 · 在家就能练 · 一次约 8–10 分钟</view>

  <!-- 存储诊断：**只有开发版显示**（体验版/正式版藏起来 —— 分享给朋友时不该看到这种技术行）
       env={{envVersion}} 是给"预览码到底算哪个环境"做实证用的（以前只能靠推断） -->
  <view class="store-diag" wx:if="{{debugEnabled && storeInfo}}" bindlongpress="onBuildLongPress">
    <text class="build">build {{build.stamp}}</text>
    <text>env={{envVersion}}</text>
    <text>存储：{{storeInfo.backend}}</text>
    <text>记录 {{storeInfo.sessions}} 条</text>
    <text wx:if="{{storeInfo.pending > 0}}">未提交 {{storeInfo.pending}} 组</text>
    <text wx:if="{{storeInfo.sizeKB !== undefined}}">已用 {{storeInfo.sizeKB}} KB</text>
    <text class="err" wx:if="{{storeInfo.error}}">⚠ {{storeInfo.error}}</text>
    <text class="dbg">· 长按可调试{{hasDebugSnapshot ? '（有备份）' : ''}}</text>
  </view>

  <!-- 有已记录但未提交的组 -->
  <view class="pending-tip" wx:if="{{pendingSets > 0}}" data-id="{{pendingList[0].stepId}}" bindtap="goStepById">
    <text class="pending-title">有 {{pendingSets}} 组已记录，还没提交</text>
    <text>点这里继续（或到该动作点"完成本次训练"提交）</text>
  </view>

  <!-- 继续训练 -->
  <view class="card" wx:if="{{main}}">
    <view class="row-between">
      <view>
        <view class="light" style="font-size:22rpx;">{{main.title}}</view>
        <view style="font-size:36rpx;font-weight:700;margin-top:6rpx;">
          {{main.artName}} · 第 {{main.no}} 式
        </view>
        <view class="muted" style="font-size:24rpx;">{{main.stepName}}</view>
      </view>
      <view class="badge">≤ 10 分钟</view>
    </view>
    <view class="muted" style="font-size:24rpx;margin-top:14rpx;">{{main.stdLine}}</view>
    <view class="btn primary" bindtap="goMain">开始这一式</view>
    <!-- 极简入口：回应访谈里"上班没时间" —— 不用等达标，记几组就算 -->
    <view class="quick-entry" bindtap="goMainQuick">
      今天只有 10 分钟？→ 只练这一式，记几组就提交（不用等达标）
    </view>
    <view class="light" style="font-size:22rpx;margin-top:12rpx;">{{main.reason}}</view>
  </view>

  <!-- 六艺全部通关 -->
  <view class="card all-done" wx:if="{{allDone}}">
    <view class="all-done-title">六艺十式 · 全部通关</view>
    <view class="muted" style="font-size:24rpx;margin-top:8rpx;">
      60 式全部达标。想继续可以任选一艺复习，或重置某个艺重新走一遍。
    </view>
    <view class="row-between" style="margin-top:20rpx;">
      <text class="done-text" style="font-size:26rpx;">已通关 {{completedCount}} / 6 艺</text>
      <text class="light" style="font-size:22rpx;">点下方任意一艺即可复习</text>
    </view>
  </view>

  <!-- 概览 -->
  <view class="stat-row">
    <view class="stat">
      <view class="stat-num">{{weeklyCount}}</view>
      <view class="light" style="font-size:22rpx;">近 7 天训练天数</view>
    </view>
    <view class="stat">
      <view class="stat-num">{{totalSessions}}</view>
      <view class="light" style="font-size:22rpx;">累计记录组次</view>
    </view>
  </view>

  <!-- 六艺 -->
  <view class="sec-title">六艺</view>
  <view class="grid">
    <view class="art-card {{item.completed ? 'is-done' : ''}}" wx:for="{{arts}}" wx:key="id" data-id="{{item.id}}" bindtap="goArt">
      <image class="art-img" src="{{item.cover}}" mode="aspectFit" />
      <view class="art-name">{{item.name}}</view>
      <view class="light" style="font-size:20rpx;">{{item.en}} · {{item.focus}}</view>
      <view class="muted" style="font-size:22rpx;margin-top:8rpx;">{{item.tagline}}</view>
      <view class="bar"><view class="bar-in" style="width:{{item.percent}}%;"></view></view>
      <!-- 一行放下：左边状态、右边进度数字。以前写成"进行中 · 第 1 式 + 通过 0/10 · 图 10/10"，
           半个卡片宽根本放不下 → 折成三行（真机验收发现） -->
      <view class="art-state">
        <text class="art-state-text {{item.stateClass}}">{{item.stateText}}</text>
        <text class="art-state-num">{{item.passedCount}}/{{item.total}}</text>
      </view>
      <!-- 示意图没画全时才提一句；画全了就安静（不再显示"图 10/10"占地方） -->
      <view class="fig-tag" wx:if="{{item.drawn < item.total}}">部分示意图待补</view>
    </view>
  </view>

  <!-- 分享：回应访谈里排第一的放弃原因"没人陪着练" —— 最低成本的做法是"能喊人"
       （真的搭子/排行榜需要后端，已记入 v2） -->
  <button class="btn ghost share-btn" open-type="share">把「六艺十式」发给朋友一起练</button>

  <view class="disclaimer">
    本小程序是训练记录工具，提供的动作标准与要点仅供健身参考，不构成医疗或康复建议；如有伤病请先咨询医生。
    动作示意图为自绘，书籍文字与插图版权归原作者及出版方所有。
  </view>
  <!-- 版本号：**所有环境都显示**，这是正常的产品信息（不是调试信息）。
       真机验收时看这一行确认"手机上跑的是不是新包"—— 每次上传必须 bump 版本号（见 README §版本固化） -->
  <view class="app-version">v{{build.version}}</view>

</view>
